<Window x:Class="Choose_students.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="谁是倒霉蛋？——By Lina"
        Height="700" Width="480"
        MinHeight="600" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <!-- ===== 颜色 ===== -->
        <SolidColorBrush x:Key="AppleBlue"      Color="#007AFF"/>
        <SolidColorBrush x:Key="AppleBlueDark"  Color="#0066CC"/>
        <SolidColorBrush x:Key="AppleBluePress" Color="#004FA3"/>
        <SolidColorBrush x:Key="AppleText"      Color="#1D1D1F"/>
        <SolidColorBrush x:Key="AppleSecText"   Color="#6E6E73"/>

        <!-- ===== 交通灯按钮 ===== -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="14"/>
            <Setter Property="Height"          Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="dot" Width="14" Height="14"
                                     Fill="{TemplateBinding Background}"/>
                            <ContentPresenter x:Name="icon"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver,
                                RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                Value="True">
                                <Setter TargetName="icon" Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 步进器按钮 ===== -->
        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="44"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="22"/>
            <Setter Property="FontWeight"      Value="Light"/>
            <Setter Property="Foreground"      Value="{StaticResource AppleBlue}"/>
            <Setter Property="Background"      Value="#F2F2F7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E5EA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D1D1D6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F2F2F7"/>
                                <Setter Property="Foreground" Value="#C7C7CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== RUN 按钮 ===== -->
        <Style x:Key="RunButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AppleBlue}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="58"/>
            <Setter Property="FontSize"        Value="20"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="Segoe UI, Microsoft YaHei"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="16" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4"
                                                  Opacity="0.22" Color="#007AFF"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AppleBlueDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AppleBluePress}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#C7C7CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 结果淡入动画（平时用） ===== -->
        <Storyboard x:Key="FadeInResult">
            <DoubleAnimation Storyboard.TargetName="ResultCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ResultCardTranslate"
                             Storyboard.TargetProperty="Y"
                             From="16" To="0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ===== 原神遮罩淡入 ===== -->
        <Storyboard x:Key="GenshinOverlayIn">
            <DoubleAnimation Storyboard.TargetName="GenshinOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ===== 原神遮罩淡出 ===== -->
        <Storyboard x:Key="GenshinOverlayOut" Completed="GenshinOverlayOut_Completed">
            <DoubleAnimation Storyboard.TargetName="GenshinOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ===== 光柱扫光动画 ===== -->
        <Storyboard x:Key="LightBeamAnim">
            <DoubleAnimation Storyboard.TargetName="LightBeamTranslate"
                             Storyboard.TargetProperty="X"
                             From="-600" To="600" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LightBeam"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="0.85" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="LightBeam"
                             Storyboard.TargetProperty="Opacity"
                             From="0.85" To="0" Duration="0:0:0.3"
                             BeginTime="0:0:0.6"/>
        </Storyboard>

        <!-- ===== 全屏白闪 ===== -->
        <Storyboard x:Key="WhiteFlash">
            <DoubleAnimation Storyboard.TargetName="FlashOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0.9" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="4"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </Window.Resources>

    <!-- ===== 最外层圆角窗口 ===== -->
    <Border CornerRadius="20" ClipToBounds="True" SnapsToDevicePixels="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F2F2F7" Offset="0.0"/>
                <GradientStop Color="#E8E8ED" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.18" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== 标题栏 ===== -->
            <Border Grid.Row="0" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel x:Name="TrafficLights"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="16 0 0 0">
                        <Button Background="#FF5F57" Style="{StaticResource TitleBarButtonStyle}"
                                Click="BtnClose_Click" Margin="0 0 8 0" ToolTip="退出程序">
                            <TextBlock Text="✕" FontSize="8" Foreground="#8B1A1A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnMinimize" Background="#FEBC2E"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="BtnMinimize_Click" Margin="0 0 8 0" ToolTip="最小化到托盘">
                            <TextBlock Text="—" FontSize="8" Foreground="#7A5A00"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Background="#28C840" Style="{StaticResource TitleBarButtonStyle}" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock Text="谁是倒霉蛋？"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI, Microsoft YaHei"
                               FontSize="15" FontWeight="SemiBold" Foreground="#3A3A3C"/>
                </Grid>
            </Border>

            <!-- ===== 主内容区 ===== -->
            <Grid Grid.Row="1" Margin="24 0 24 24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 结果卡片 -->
                <Border x:Name="ResultCard" Grid.Row="0"
                        Background="White" CornerRadius="18"
                        Margin="0 0 0 20" Opacity="1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ResultCardTranslate" Y="0"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.07" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Border Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Background="{StaticResource AppleBlue}" CornerRadius="4 0 0 4"/>
                        <StackPanel Margin="24 22 22 22">
                            <TextBlock Text="🎲  本次倒霉蛋"
                                       FontFamily="Segoe UI, Microsoft YaHei"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppleSecText}"
                                       Margin="0 0 0 10"/>
                            <TextBlock x:Name="txtBadLuck"
                                       Text="点击「随机抽取」开始"
                                       TextWrapping="Wrap"
                                       FontFamily="Segoe UI, Microsoft YaHei"
                                       FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource AppleText}"
                                       LineHeight="42" MinHeight="120"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 步进器 -->
                <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="20 14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="抽取人数"
                                       FontFamily="Segoe UI, Microsoft YaHei"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppleText}"/>
                            <TextBlock x:Name="TotalHint" Text="共 32 人可抽"
                                       FontFamily="Segoe UI, Microsoft YaHei"
                                       FontSize="12" Foreground="{StaticResource AppleSecText}"
                                       Margin="0 2 0 0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="BtnMinus" Content="−"
                                    Style="{StaticResource StepperButtonStyle}"
                                    Click="BtnMinus_Click"/>
                            <TextBlock x:Name="CountLabel" Text="1"
                                       FontFamily="Segoe UI, Microsoft YaHei"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource AppleText}"
                                       Width="56" TextAlignment="Center"
                                       VerticalAlignment="Center" Margin="4 0"/>
                            <Button x:Name="BtnPlus" Content="+"
                                    Style="{StaticResource StepperButtonStyle}"
                                    Click="BtnPlus_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- RUN 按钮 -->
                <Button Grid.Row="3" x:Name="BtnRun"
                        Style="{StaticResource RunButtonStyle}"
                        Click="Button_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎰" FontSize="20" VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <TextBlock Text="随机抽取"
                                   FontFamily="Segoe UI, Microsoft YaHei"
                                   FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 签名 -->
                <StackPanel Grid.Row="4" Orientation="Horizontal"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             Margin="0 14 0 0">
                    <TextBlock Text="By Lina"
                               FontSize="14" FontStyle="Italic"
                               Foreground="#999999" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ========================================
                 原神抽卡覆盖层（默认隐藏，抽卡时显示）
                 ======================================== -->
            <Grid x:Name="GenshinOverlay"
                  Grid.RowSpan="2"
                  Opacity="0"
                  IsHitTestVisible="False"
                  Panel.ZIndex="100">

                <!-- 深色星空背景 -->
                <Border x:Name="GenshinBg">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                            <GradientStop Color="#0A0A1A" Offset="0"/>
                            <GradientStop Color="#0D1B3E" Offset="0.4"/>
                            <GradientStop Color="#1A0A2E" Offset="0.7"/>
                            <GradientStop Color="#0A0A1A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 星星粒子层（静态散点） -->
                <Canvas x:Name="StarCanvas" IsHitTestVisible="False"/>

                <!-- 光柱 -->
                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                    <Rectangle x:Name="LightBeam"
                               Width="160" Height="900"
                               Opacity="0" Canvas.Top="-100">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent"    Offset="0"/>
                                <GradientStop Color="#40E8D5A3"      Offset="0.3"/>
                                <GradientStop Color="#80F5E6B8"      Offset="0.5"/>
                                <GradientStop Color="#40E8D5A3"      Offset="0.7"/>
                                <GradientStop Color="Transparent"    Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="LightBeamTranslate" X="-600"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>

                <!-- 卡片容器（动态生成） -->
                <Canvas x:Name="CardCanvas" IsHitTestVisible="False"/>

                <!-- 全屏白闪层 -->
                <Border x:Name="FlashOverlay" Background="White" Opacity="0" IsHitTestVisible="False"/>

                <!-- 点击跳过提示 -->
                <TextBlock x:Name="SkipHint"
                           Text="点击任意处跳过"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0 0 0 24"
                           FontFamily="Segoe UI, Microsoft YaHei"
                           FontSize="13"
                           Foreground="#60FFFFFF"
                           IsHitTestVisible="False"/>

            </Grid>

            <!-- 点击跳过捕获层 -->
            <Border x:Name="SkipLayer"
                    Grid.RowSpan="2"
                    Background="Transparent"
                    Panel.ZIndex="99"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="SkipLayer_Click"/>

        </Grid>
    </Border>
</Window>
