<Window x:Class="Choose_students.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="谁是倒霉蛋？——By Lina"
        Height="700" Width="480"
        MinHeight="600" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource PixelFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ===== 纸面点阵纹理（8px 平铺） ===== -->
        <DrawingBrush x:Key="PaperTexture" TileMode="Tile"
                      Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource PaperBackdrop}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,8,8"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource PaperTextureA}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,2,2"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource PaperTextureA}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="4,4,2,2"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ===== 标题栏方形像素按钮 ===== -->
        <Style x:Key="TrafficLightStyle" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="0 0 6 0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource BorderDark}"
                                    BorderThickness="2">
                                <ContentPresenter x:Name="icon" Opacity="0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver,
                                RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                Value="True">
                                <Setter TargetName="icon" Property="Opacity" Value="1"/>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 步进器像素方钮（硬阴影 + 斜面边框） ===== -->
        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root">
                            <Border x:Name="shadow" Margin="3,3,0,0"
                                    Background="{StaticResource BorderDark}"/>
                            <Border x:Name="bd"
                                    Background="{StaticResource CardFill}"
                                    BorderBrush="{StaticResource BorderDark}"
                                    BorderThickness="2">
                                <Grid>
                                    <Border BorderBrush="{StaticResource BorderLight}"
                                            BorderThickness="1" Margin="2"/>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FBEED3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="2" Y="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 主操作按钮（强调暖红 + 琥珀内框） ===== -->
        <Style x:Key="RunButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource CardFill}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root">
                            <Border x:Name="shadow" Margin="5,5,0,0"
                                    Background="{StaticResource BorderDark}"/>
                            <Border x:Name="bd"
                                    Background="{StaticResource AccentBrush}"
                                    BorderBrush="{StaticResource BorderDark}"
                                    BorderThickness="3">
                                <Grid>
                                    <Border BorderBrush="{StaticResource AmberBrush}"
                                            BorderThickness="2" Margin="2"/>
                                    <Border Height="7" VerticalAlignment="Top"
                                            Margin="8,3,8,0" Background="#66FFD9A8"
                                            IsHitTestVisible="False"/>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="3" Y="3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 结果卡硬切淡入 ===== -->
        <Storyboard x:Key="FadeInResult">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ResultCard"
                                           Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:0.16">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.4"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0.8"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ResultCardTranslate"
                                           Storyboard.TargetProperty="Y"
                                           Duration="0:0:0.16">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="10"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="4"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.16" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ===== 点名遮罩硬切淡入 ===== -->
        <Storyboard x:Key="OceanOverlayIn">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OceanOverlay"
                                           Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:0.16">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.4"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0.8"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ===== 点名遮罩硬切淡出 ===== -->
        <Storyboard x:Key="OceanOverlayOut" Completed="OceanOverlayOut_Completed">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OceanOverlay"
                                           Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:0.2">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="0.6"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="0.3"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ===== 收尾像素闪光环 ===== -->
        <Storyboard x:Key="SoftPulse">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PulseRing"
                                           Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:0.55">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.9"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="0.5"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.36" Value="0.2"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PulseRingScale"
                                           Storyboard.TargetProperty="ScaleX"
                                           Duration="0:0:0.55">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.6"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="1.1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.36" Value="1.5"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="1.8"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PulseRingScale"
                                           Storyboard.TargetProperty="ScaleY"
                                           Duration="0:0:0.55">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.6"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="1.1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.36" Value="1.5"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="1.8"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ===== 点名前的像素呼吸方框（持续） ===== -->
        <Storyboard x:Key="BreathRingAnim">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BreathRing"
                                           Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:1.2" RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.12"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0.22"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0.12"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BreathRingScale"
                                           Storyboard.TargetProperty="ScaleX"
                                           Duration="0:0:1.2" RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="1.35"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BreathRingScale"
                                           Storyboard.TargetProperty="ScaleY"
                                           Duration="0:0:1.2" RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="1.35"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

    </Window.Resources>

    <!-- ===== 像素窗框：偏移实心硬阴影 + 深色方角边框 ===== -->
    <Grid>
        <Border Margin="21,21,11,11" Background="{StaticResource BorderDark}"
                IsHitTestVisible="False"/>

        <Border Margin="16" Background="{StaticResource PaperBackdrop}"
                BorderBrush="{StaticResource BorderDark}" BorderThickness="3"
                ClipToBounds="True" SnapsToDevicePixels="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===== 纸面纹理 + 静态像素装饰（底层） ===== -->
                <Grid Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="0">
                    <Border Background="{StaticResource PaperTexture}"/>
                    <Canvas ClipToBounds="True">
                        <Grid Width="20" Height="20" Canvas.Left="34" Canvas.Top="126"
                              Opacity="0.30">
                            <Rectangle Width="4" Height="16" Fill="{StaticResource AmberBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle Width="16" Height="4" Fill="{StaticResource AmberBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Width="12" Height="12" Canvas.Left="392" Canvas.Top="272"
                              Opacity="0.22">
                            <Rectangle Width="3" Height="9" Fill="{StaticResource AmberBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle Width="9" Height="3" Fill="{StaticResource AmberBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Width="14" Height="14" Canvas.Left="52" Canvas.Top="548"
                              Opacity="0.25">
                            <Rectangle Width="3" Height="11" Fill="{StaticResource AmberBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle Width="11" Height="3" Fill="{StaticResource AmberBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Width="12" Height="12" Canvas.Left="398" Canvas.Top="64"
                                Opacity="0.40"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                            <Grid Margin="2">
                                <Rectangle Width="2" Height="2" Fill="{StaticResource CardFill}"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Rectangle Width="2" Height="2" Fill="{StaticResource CardFill}"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>
                    </Canvas>
                </Grid>

                <!-- ===== 标题栏 ===== -->
                <Border Grid.Row="0" Background="{StaticResource PanelFill}"
                        BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,3"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel x:Name="TrafficLights"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="14 0 0 0">
                            <Button Background="{StaticResource AccentBrush}"
                                    Style="{StaticResource TrafficLightStyle}"
                                    Click="BtnClose_Click" ToolTip="退出">
                                <TextBlock Text="✕" FontSize="8" Foreground="#4A1810"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="BtnMinimize" Background="{StaticResource AmberBrush}"
                                    Style="{StaticResource TrafficLightStyle}"
                                    Click="BtnMinimize_Click" ToolTip="最小化">
                                <TextBlock Text="—" FontSize="8" Foreground="#4A3410"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Background="{StaticResource GreenBrush}"
                                    Style="{StaticResource TrafficLightStyle}" IsEnabled="False"/>
                        </StackPanel>
                        <TextBlock Text="谁是倒霉蛋？"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource InkMutedBrush}"/>
                    </Grid>
                </Border>

                <!-- ===== 主内容 ===== -->
                <Grid Grid.Row="1" Margin="20 8 20 20" Panel.ZIndex="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 结果卡片（硬阴影 + 深色外框 + 高光内框） -->
                    <Grid Grid.Row="0" Margin="0 6 0 20">
                        <Border Margin="5,5,0,0" Background="{StaticResource BorderDark}"/>
                        <Border x:Name="ResultCard"
                                Background="{StaticResource CardFill}"
                                BorderBrush="{StaticResource BorderDark}"
                                BorderThickness="3">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ResultCardTranslate" Y="0"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Border BorderBrush="{StaticResource BorderLight}"
                                        BorderThickness="1" Margin="3"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="AccentBar" Width="6"
                                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                        Background="{StaticResource AccentBrush}"
                                        Margin="4,4,0,4"/>
                                <StackPanel Margin="24 20 20 20">
                                    <TextBlock Text="T H I S   R O U N D"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentBrush}"
                                               Margin="0 0 0 10"/>
                                    <TextBlock x:Name="txtBadLuck"
                                               Text="点击下方按钮开始"
                                               TextWrapping="Wrap"
                                               FontSize="34"
                                               Foreground="{StaticResource InkBrush}"
                                               LineHeight="46" MinHeight="110"/>
                                </StackPanel>
                                <Grid Width="24" Height="24"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0 14 16 0" Opacity="0.45"
                                      IsHitTestVisible="False">
                                    <Rectangle Width="5" Height="20"
                                               Fill="{StaticResource AmberBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Rectangle Width="20" Height="5"
                                               Fill="{StaticResource AmberBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 抽取人数（像素小面板） -->
                    <Grid Grid.Row="1">
                        <Border Margin="4,4,0,0" Background="{StaticResource BorderDark}"/>
                        <Border Background="{StaticResource PanelFill}"
                                BorderBrush="{StaticResource BorderDark}"
                                BorderThickness="3" Padding="16 12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="抽取人数"
                                               FontSize="15"
                                               Foreground="{StaticResource InkBrush}"/>
                                    <TextBlock x:Name="TotalHint" Text="共 32 人可抽"
                                               FontSize="11.5"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Margin="0 2 0 0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="BtnMinus" Content="−"
                                            Style="{StaticResource StepperButtonStyle}"
                                            Click="BtnMinus_Click"/>
                                    <TextBlock x:Name="CountLabel" Text="1"
                                               FontSize="28"
                                               Foreground="{StaticResource InkBrush}"
                                               Width="54" TextAlignment="Center"
                                               VerticalAlignment="Center" Margin="2 0"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <Button x:Name="BtnPlus" Content="+"
                                            Style="{StaticResource StepperButtonStyle}"
                                            Click="BtnPlus_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 随机抽取 -->
                    <Button Grid.Row="3" x:Name="BtnRun"
                            Style="{StaticResource RunButtonStyle}"
                            Click="Button_Click"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                        <TextBlock Text="随机抽取"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>
                    </Button>

                    <!-- Byline -->
                    <TextBlock Grid.Row="4" Text="By Lina"
                               HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="{StaticResource InkMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0 10 2 0"/>
                </Grid>

                <!-- ===== 点名遮罩（纸面 + 像素装饰） ===== -->
                <Grid x:Name="OceanOverlay"
                      Grid.RowSpan="2"
                      Opacity="0"
                      IsHitTestVisible="False"
                      Panel.ZIndex="100"
                      ClipToBounds="True">

                    <Border Background="{StaticResource PaperBackdrop}"/>
                    <Border Background="{StaticResource PaperTexture}"/>

                    <Canvas IsHitTestVisible="False">
                        <Grid Width="14" Height="14" Canvas.Left="38" Canvas.Top="72"
                              Opacity="0.28">
                            <Rectangle Width="3" Height="11" Fill="{StaticResource AmberBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle Width="11" Height="3" Fill="{StaticResource AmberBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Width="10" Height="10" Canvas.Left="396" Canvas.Top="470"
                              Opacity="0.22">
                            <Rectangle Width="3" Height="8" Fill="{StaticResource AmberBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle Width="8" Height="3" Fill="{StaticResource AmberBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Canvas>

                    <!-- 名字像素卡叠放层 -->
                    <Canvas x:Name="NameCanvas" IsHitTestVisible="False"/>

                    <!-- 双环（置于牌堆之上，完整可见）：内圈琥珀呼吸 + 外圈暖红脉冲 -->
                    <Border x:Name="BreathRing" Opacity="0"
                            Width="210" Height="210"
                            BorderBrush="{StaticResource AmberBrush}" BorderThickness="3"
                            Background="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BreathRingScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- 收尾闪光方框 -->
                    <Border x:Name="PulseRing" Opacity="0"
                            Width="220" Height="220"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="4"
                            Background="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PulseRingScale" ScaleX="0.6" ScaleY="0.6"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- 跳过提示 -->
                    <TextBlock Text="点击任意位置跳过"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Margin="0 0 0 26"
                               FontSize="12" Foreground="{StaticResource InkMutedBrush}"
                               Opacity="0.65" IsHitTestVisible="False"/>
                </Grid>

                <!-- 跳过点击层（置于遮罩之上，保证随时可跳过） -->
                <Border x:Name="SkipLayer"
                        Grid.RowSpan="2"
                        Background="Transparent"
                        Panel.ZIndex="200"
                        Visibility="Collapsed"
                        MouseLeftButtonDown="SkipLayer_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
